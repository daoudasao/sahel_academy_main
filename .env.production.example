# ─────────────────────────────────────────────────────────────
# Variables Portainer — PRODUCTION derrière le domaine sahel-academy.com
# (le nginx-proxy-manager du serveur redirige les domaines vers les conteneurs)
#
#   sahel-academy.com       → conteneur sahel_academy_web     (port interne 3000)
#   api.sahel-academy.com   → conteneur sahel_academy_backend (port interne 3001)
#
# ⚠️ Les NEXT_PUBLIC_* et API_URL sont FIGÉES AU BUILD : après les avoir
#    changées, il faut REDÉPLOYER EN RECONSTRUISANT le site (rebuild).
# ─────────────────────────────────────────────────────────────

# --- Base de données Neon (à renseigner) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require

# --- Auth ---
BETTER_AUTH_SECRET=change-moi-secret-long-aleatoire
BETTER_AUTH_URL=https://api.sahel-academy.com
# Cookie partagé entre le site et l'API (les deux sous *.sahel-academy.com)
COOKIE_DOMAIN=.sahel-academy.com

# --- URLs du front (CORS + redirections côté backend) ---
FRONTEND_URL=https://sahel-academy.com
WEB_URL=https://sahel-academy.com
ADMIN_URL=https://sahel-academy.com
VERIF_URL=https://sahel-academy.com

# --- Build args du site Next.js (figés au build → rebuild obligatoire) ---
NEXT_PUBLIC_API_URL=https://api.sahel-academy.com/api/v1
NEXT_PUBLIC_VERIF_URL=https://sahel-academy.com

# --- Ports publiés sur l'hôte ---
# Gardés pour que le proxy puisse joindre les conteneurs via l'IP:port de l'hôte
# si besoin (sinon le proxy les joint par leur nom sur un réseau partagé).
# 3000 étant déjà pris sur ce serveur mutualisé, le site sort sur 8480.
WEB_PORT=8480
# BACKEND_PORT laissé par défaut (3001)

# --- Intégrations optionnelles ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ENDPOINT=
BUNNY_CDN_DOMAIN=
FIREBASE_ADMIN_CREDENTIALS_BASE64=
